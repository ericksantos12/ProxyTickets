BOT_TOKEN=
DATABASE_URL=
NODE_OPTIONS=
WEBHOOK_LOGS_URL=
GUILD_ID=
MP_ACCESS_TOKEN=
MP_SANDBOX=true
MP_TEST_PAYER_EMAIL=test@testuser.com
API_TOKEN=
API_HOST=0.0.0.0
API_PORT=3000

# BOT_TOKEN
# Token do bot do Discord (obrigatorio).
#
# DATABASE_URL
# URL de conexao do MongoDB usada pelo Prisma (obrigatorio).
# Ex: mongodb+srv://user:pass@cluster/db?retryWrites=true&w=majority
#
# NODE_OPTIONS
# Opcoes adicionais do Node.js (opcional).
# Ex: --max-old-space-size=4096
#
# WEBHOOK_LOGS_URL
# Webhook para enviar logs do bot (opcional).
#
# GUILD_ID
# ID do servidor para registrar comandos em escopo de guild (opcional).
#
# MP_ACCESS_TOKEN
# Access Token do Mercado Pago (obrigatorio).
#
# MP_SANDBOX
# Envia X-Test-Token para tratar chamadas do Mercado Pago como teste (padrao: true).
#
# MP_TEST_PAYER_EMAIL
# Email do pagador usado pela Orders API em sandbox (opcional, padrao: test@testuser.com).
#
# API_TOKEN
# Token secreto usado nas rotas protegidas da API HTTP de pedidos (obrigatorio).
#
# API_HOST
# Host em que o servidor HTTP da API escuta (opcional, padrao: 0.0.0.0).
#
# API_PORT
# Porta em que o servidor HTTP da API escuta (opcional, padrao: 3000).
