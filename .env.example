BOT_TOKEN=
DATABASE_URL=
NODE_OPTIONS=
WEBHOOK_LOGS_URL=
GUILD_ID=
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
WEBHOOK_BASE_URL=
WEBHOOK_PORT=

# BOT_TOKEN
# Token do bot do Discord (obrigatorio).
#
# DATABASE_URL
# URL de conexao do MongoDB usada pelo Prisma (obrigatorio).
# Ex: mongodb+srv://user:pass@cluster/db?retryWrites=true&w=majority
#
# NODE_OPTIONS
# Opcoes adicionais do Node.js (opcional).
# Ex: --max-old-space-size=4096
#
# WEBHOOK_LOGS_URL
# Webhook para enviar logs do bot (opcional).
#
# GUILD_ID
# ID do servidor para registro de comandos em escopo de guild (opcional).
#
# MP_ACCESS_TOKEN
# Access Token do Mercado Pago (obrigatorio).
#
# MP_WEBHOOK_SECRET
# Secret para validar assinatura dos webhooks do Mercado Pago (obrigatorio).
#
# WEBHOOK_BASE_URL
# URL publica base para receber webhooks do Mercado Pago (obrigatorio).
# Ex: https://seu-dominio.com ou https://seu-ngrok.ngrok.io
#
# WEBHOOK_PORT
# Porta do servidor Express de webhook (opcional, padrao 3001).
